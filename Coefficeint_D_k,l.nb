         SuperscriptBox["x", "4"]}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", 
       RowBox[{"(", 
        RowBox[{"144", "-", 
         RowBox[{"48", " ", "x"}], "-", 
         RowBox[{"12", " ", 
          SuperscriptBox["x", "2"]}], "+", 
         RowBox[{"12", " ", 
          SuperscriptBox["x", "3"]}], "+", 
         SuperscriptBox["x", "4"], "+", 
         SuperscriptBox["x", "5"]}], ")"}]}]}], ")"}]}]}],
  SequenceForm[
