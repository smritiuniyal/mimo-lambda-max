Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Base", " ", "function", " ", "from", " ", "Maaref"}], "\[Dash]", 
    RowBox[{"A\[IDoubleDot]ssa", " ", 
     RowBox[{"(", 
      RowBox[{"incomplete", " ", "gamma", " ", "form"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "myfunction", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"myfunction", "[", 
      RowBox[{"k_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}], "!"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", "x"}], "]"}], "*", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "^", "m"}], "/", 
            RowBox[{"Factorial", "[", "m", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "0", ",", 
             RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "computeCoefficients", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"computeCoefficients", "[", 
      RowBox[{"n_Integer", ",", "m_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "p", ",", "matrix", ",", "kmn", ",", "det1", ",", "f", ",", 
         "k", ",", "l", ",", "A", ",", "g", ",", "tAlpha", ",", "tA"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{"Symbol", "[", "\"\<x\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"n", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"matrix", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"myfunction", "[", 
            RowBox[{
             RowBox[{"n", "-", "m", "+", "i", "+", "j", "-", "1"}], ",", 
             "x"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "p"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "p"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kmn", "=", 
         RowBox[{"1", "/", 
          RowBox[{"Product", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Factorial", "[", 
              RowBox[{"m", "-", "i"}], "]"}], "*", 
             RowBox[{"Factorial", "[", 
              RowBox[{"n", "-", "i"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "p"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"p_", 
           RowBox[{"{", "\[Lambda]_max", "}"}], 
           RowBox[{"(", "x", ")"}]}], "=", 
          RowBox[{"K_", 
           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}], " ", 
           RowBox[{"d", "/", "dx"}], " ", "det", 
           RowBox[{"(", "matrix", ")"}]}]}], "*)"}], 
        RowBox[{"det1", "=", 
         RowBox[{"Det", "[", "matrix", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"f", "=", 
         RowBox[{"Simplify", "[", 
          RowBox[{"kmn", "*", 
           RowBox[{"D", "[", 
            RowBox[{"det1", ",", "x"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Kmn = \>\"", ",", "kmn"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<p_{\[Lambda]max}(x) = f(x) = \>\"", ",", "f"}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Clear", "[", 
         RowBox[{"alph", ",", "a"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"k", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"l", "=", 
         RowBox[{"n", "+", "m", "-", "2"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"k", "<=", "m"}], ",", 
          RowBox[{
           RowBox[{"A", "=", 
            RowBox[{"f", "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", "^", "l"}], "*", 
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "k"}], " ", "x"}], "]"}]}], ")"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"alph", "[", 
             RowBox[{"k", ",", "l"}], "]"}], "=", 
            RowBox[{
             RowBox[{"kmn", "^", 
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}]}], "*", 
             RowBox[{"Limit", "[", 
              RowBox[{"A", ",", 
               RowBox[{"x", "->", "Infinity"}]}], "]"}]}]}], ";", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"k", ",", "l"}], "]"}], "=", 
            RowBox[{"kmn", "*", 
             RowBox[{"alph", "[", 
              RowBox[{"k", ",", "l"}], "]"}], "*", 
             RowBox[{
              RowBox[{"Factorial", "[", "l", "]"}], "/", 
              RowBox[{"(", 
               RowBox[{"k", "^", 
                RowBox[{"(", 
                 RowBox[{"l", "+", "1"}], ")"}]}], ")"}]}]}]}], ";", 
           RowBox[{"g", "=", 
            RowBox[{"kmn", "*", 
             RowBox[{"alph", "[", 
              RowBox[{"k", ",", "l"}], "]"}], "*", 
             RowBox[{"x", "^", "l"}], "*", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "k"}], " ", "x"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"f", "=", 
            RowBox[{"Simplify", "[", 
             RowBox[{"f", "-", "g"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"l", "--"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"l", ">=", 
              RowBox[{"n", "-", "m"}]}], ",", 
             RowBox[{"Continue", "[", "]"}], ",", 
             RowBox[{
              RowBox[{"k", "++"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"k", "<=", "m"}], ",", 
                RowBox[{"l", "=", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", "+", "m", "-", 
                    RowBox[{"2", "*", "k"}]}], ")"}], "*", "k"}]}], ",", 
                RowBox[{"Break", "[", "]"}]}], "]"}], ";"}]}], "]"}], ";"}]}],
          "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Remaining f after expansion (should be 0): \>\"", ",", "f"}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tAlpha", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"alph", "[", 
            RowBox[{"k", ",", "l"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "1", ",", 
             RowBox[{"n", "+", "m", "-", "2"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tA", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"k", ",", "l"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "m"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "1", ",", 
             RowBox[{"n", "+", "m", "-", "2"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<Table[alph[k, l], {k, 1, m}, {l, 1, n + m - 2}] = \>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "tAlpha", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<Table[a[k, l], {k, 1, m}, {l, 1, n + m - 2}] = \>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "tA", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"kmn", ",", "f", ",", "tAlpha", ",", "tA"}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"n", "=", "4"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", "=", "3"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"computeCoefficients", "[", 
     RowBox[{"n", ",", "m"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
